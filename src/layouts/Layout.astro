---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "Oliver Ohrt's tools and projects.", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3a587a" />
    <meta name="color-scheme" content="only light" />
    <meta name="darkreader-lock" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="Oliver Ohrt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body>
    <header>
      <div class="banner">
        <div class="banner-inner">
          <a class="logo" href="/">
            <picture>
              <source srcset="/images/logo_still.webp" media="(prefers-reduced-motion: reduce)" />
              <img
                class="chrome"
                src="/images/logo_spin.webp"
                srcset="/images/logo_spin.webp 1x, /images/logo_spin@2x.webp 2x"
                alt="tools.ohrt.dev"
                width="360"
                height="54"
              />
            </picture>
          </a>
        </div>
      </div>
      <nav class="bar">
        <div class="bar-inner">
          <span>
            <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
              projects
            </a>
            <a href="https://blog.ohrt.dev">weblog</a>
            <a href="https://ohrt.dev">ohrt.dev</a>
          </span>
          <a href="https://status.ohrt.dev">status</a>
        </div>
      </nav>
    </header>
    <div class="wrapper">
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  /* the root colour shows when you overscroll and tints iOS Safari's bars: header blue near the top, paper below */
  html {
    background: #fdfcf9;
  }

  @supports (animation-timeline: scroll()) {
    html {
      animation: overscroll linear both;
    }

    /* separate rule so the minifier can't fold the timeline into the shorthand, which browsers reject */
    :root {
      animation-timeline: scroll(root);
    }
  }

  @keyframes overscroll {
    0%,
    49.9% {
      background-color: #3a587a;
    }

    50%,
    100% {
      background-color: #fdfcf9;
    }
  }

  body {
    margin: 0;
    /* paper as an image, not a colour: WebKit ignores body images when it picks the page colour, so html's wins */
    background: linear-gradient(#fdfcf9, #fdfcf9);
    color: #23314b;
    font-family: 'Helvetica Neue', helvetica, arial, sans-serif;
    line-height: 1.45;
  }

  a {
    color: #2f55a4;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: georgia, serif;
    font-weight: normal;
  }

  .banner-inner,
  .bar-inner,
  .wrapper {
    max-width: calc(46rem - 40px);
    margin: 0 auto;
    padding: 0 38px;
  }

  .banner {
    height: 75px;
    background:
      linear-gradient(rgb(30 45 69 / 0.5), rgb(30 45 69 / 0.5)),
      url('/images/header.png') center / cover;
    border-bottom: 1px solid #1d2a42;
  }

  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    flex: 0 1 288px;
    min-width: 0;
    /* puts the t's stem on the nav text's left edge */
    margin-left: -6px;
  }

  .chrome {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.5));
  }

  .bar {
    background: linear-gradient(to bottom, #6c94c6 0%, #4c6fab 50%, #44617d 51%, #5674ae 100%);
  }

  .bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 32px;
    font-size: 14px;
  }

  .bar a {
    color: #fff;
    text-decoration: none;
  }

  .bar span a {
    margin-right: 20px;
  }

  .bar a:hover,
  .bar a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bar a:focus-visible {
    outline: 1px dotted #fff;
  }

  .wrapper {
    min-height: 60vh;
    padding-top: 16px;
    padding-bottom: 80px;
  }

  .mono {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 12.5px;
    letter-spacing: 0.2px;
    color: #6b7486;
  }

  @media (max-width: 47rem) {
    .banner-inner,
    .bar-inner {
      padding: 0 20px;
    }

    .wrapper {
      margin: 0 16px;
      padding-left: 12px;
      padding-right: 12px;
    }

    .banner {
      height: 55px;
    }

    .logo {
      flex-basis: 208px;
      margin-left: -4px;
    }
  }
</style>
