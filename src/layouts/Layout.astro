---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "Oliver Ohrt's tools and projects.", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// the home page has no other heading, so its logo is one
const Logo = Astro.url.pathname === '/' ? 'h1' : 'div';
const built = new Date().toLocaleString('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Chicago',
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3a587a" />
    <meta name="color-scheme" content="only light" />
    <meta name="darkreader-lock" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="Oliver Ohrt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body>
    <header>
      <div class="banner">
        <div class="banner-inner">
          <Logo class="logo">
            <a href="/">
              <picture>
                <source srcset="/images/logo_still.webp" media="(prefers-reduced-motion: reduce)" />
                <img
                  class="chrome"
                  src="/images/logo_spin.webp"
                  srcset="/images/logo_spin.webp 360w, /images/logo_spin@2x.webp 720w"
                  sizes="180px"
                  alt="tools.ohrt.dev"
                  width="360"
                  height="54"
                />
              </picture>
            </a>
          </Logo>
        </div>
      </div>
      <nav class="bar" aria-label="Sites">
        <div class="bar-inner">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
            projects
          </a>
          <a href="https://blog.ohrt.dev">weblog</a>
          <a href="https://ohrt.dev">ohrt.dev</a>
          <a class="end" href="https://status.ohrt.dev">
            status
          </a>
        </div>
      </nav>
      {Astro.slots.has('sections') && (
        <nav class="strip" aria-label="On this page">
          <div class="strip-inner">
            <slot name="sections" />
          </div>
        </nav>
      )}
    </header>
    <div class="wrapper">
      <main>
        <slot />
      </main>
    </div>
    <footer class="footer">
      <div class="footer-inner">
        <p>
          Built with <a href="https://astro.build">Astro</a>, rebuilt by GitHub Actions every push, last on {built}.
          Status from <a href="https://status.ohrt.dev">status.ohrt.dev</a>.{' '}
          <a href="https://github.com/Lavanic/tools.ohrt.dev">Source</a>.
        </p>
        <p class="load-time" hidden></p>
      </div>
    </footer>
  </body>
</html>

<script>
  const line = document.querySelector<HTMLElement>('.load-time');
  const show = () => {
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const ms = nav ? nav.loadEventEnd - nav.startTime : 0;
    if (!line || !(ms > 0)) return;
    line.textContent = `This page loaded for you in ${Math.round(ms)} ms.`;
    line.hidden = false;
  };
  if (document.readyState === 'complete') setTimeout(show);
  else addEventListener('load', () => setTimeout(show), { once: true });
</script>

<style is:global>
  :root {
    --page: #ebebeb;
    --strip: #f5f5f5;
    --line: #e0e0e0;
    --ink: #141414;
    --dim: #4f4f4f;
    --muted: #6f6f6f;
    --link: #1474b8;
    --link-hover: #0f578a;
  }

  *,
  ::before,
  ::after {
    box-sizing: border-box;
  }

  /* the root colour shows when you overscroll and tints iOS Safari's bars: header blue near the top, page grey below, footer grey at the very end */
  html {
    background: var(--page);
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  /* only where a finger can pull the page past its ends; a desktop Firefox would paint its scrollbar's lane in this colour */
  @media (hover: none) and (pointer: coarse) {
    @supports (animation-timeline: scroll()) {
      html {
        animation: overscroll linear both;
      }

      /* separate rule so the minifier can't fold the timeline into the shorthand, which browsers reject */
      :root {
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes overscroll {
    0%,
    49.9% {
      background-color: #3a587a;
    }

    50%,
    99.8% {
      background-color: #ebebeb;
    }

    99.9%,
    100% {
      background-color: #4f4f4f;
    }
  }

  /* a column at least as tall as the screen, so the footer sits at the bottom of a short page */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    /* the grey as an image, not a colour: WebKit ignores body images when it picks the page colour, so html's wins */
    background: linear-gradient(var(--page), var(--page));
    color: var(--ink);
    font:
      0.9375rem / 1.4 'Segoe UI',
      'Helvetica Neue',
      Helvetica,
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      'Fira Sans',
      'Droid Sans',
      sans-serif;
    overflow-wrap: break-word;
  }

  a {
    color: var(--link);
    text-decoration: none;
  }

  a:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-weight: 400;
  }

  .banner-inner,
  .bar-inner,
  .strip-inner,
  .wrapper,
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 10px;
  }

  /* the halftone is drawn for a 1920px screen: narrower ones see its middle, wider ones see it start over */
  .banner {
    height: 46px;
    background: #3a587a url('/images/banner.webp') center top repeat-x;
    border-bottom: 1px solid #1d2a42;
  }

  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    flex: 0 1 180px;
    min-width: 0;
    /* puts the t's stem on the open tab's left edge */
    margin-left: -4.4px;
  }

  .logo a {
    display: block;
  }

  .chrome {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
  }

  .bar {
    background: linear-gradient(to bottom, #6c94c6 0%, #4c6fab 50%, #44617d 51%, #5674ae 100%);
  }

  .bar-inner {
    display: flex;
    align-items: flex-end;
  }

  .bar a {
    padding: 8px 15px;
    color: #fff;
    text-decoration: none;
    transition: background-color 0.25s ease;
  }

  .bar a:hover {
    background: rgb(255 255 255 / 0.12);
  }

  /* the open tab takes the strip's colour, so the two read as one surface */
  .bar a[aria-current='page'] {
    border-radius: 2px 2px 0 0;
    background: var(--strip);
    color: var(--ink);
    font-weight: 700;
  }

  .bar .end {
    margin-left: auto;
    padding-inline: 10px;
  }

  .strip {
    border-bottom: 1px solid #ccc;
    background: var(--strip);
    font-size: 0.8125rem;
  }

  /* 2px here plus 8px on each link puts the first link's text on the page's left edge */
  .strip-inner {
    padding-inline: 2px;
  }

  .strip a {
    display: inline-block;
    padding: 6px 8px;
    color: var(--ink);
  }

  .strip a:hover {
    color: var(--link-hover);
  }

  .bar a:focus-visible,
  .strip a:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: -3px;
  }

  .wrapper {
    flex: 1;
    width: 100%;
    padding-top: 10px;
    padding-bottom: 20px;
  }

  /* the white box everything on the page sits in */
  .block {
    margin-bottom: 20px;
    border: 1px solid;
    border-color: #e0e0e0 #d6d6d6 #ccc;
    border-radius: 4px;
    background: #fff;
  }

  .footer {
    background: #4f4f4f;
    color: #e8f4fc;
    font-size: 0.8125rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 20px;
    padding-top: 6px;
    padding-bottom: 10px;
  }

  .footer p {
    margin: 0;
  }

  /* underlined, since these sit inside a sentence and colour alone would not mark them */
  .footer a {
    color: #a3d4f5;
    text-decoration: underline;
  }

  .footer a:hover {
    color: #fff;
  }

  @media (max-width: 650px) {
    /* a phone gets the halftone's left end, where the dots thin out behind the logo */
    .banner {
      background-position-x: left;
    }

    /* every size on the page is in rem, so a phone shrinks them all together */
    html {
      font-size: 87.5%;
    }

    /* a size down on a phone */
    body {
      font-size: 0.875rem;
    }

    /* blocks run edge to edge on a phone */
    .block {
      margin-inline: -10px;
      border-inline: 0;
      border-radius: 0;
    }
  }

  @media (max-width: 340px) {
    .bar a {
      padding-inline: 11px;
    }
  }
</style>
