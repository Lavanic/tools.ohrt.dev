---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "Oliver Ohrt's tools and projects.", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3a587a" />
    <meta name="color-scheme" content="only light" />
    <meta name="darkreader-lock" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="Oliver Ohrt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body>
    <header>
      <div class="banner">
        <div class="banner-inner">
          <a class="logo" href="/">
            <picture>
              <source srcset="/images/logo_still.webp" media="(prefers-reduced-motion: reduce)" />
              <img
                class="chrome"
                src="/images/logo_spin.webp"
                srcset="/images/logo_spin.webp 1x, /images/logo_spin@2x.webp 2x"
                alt="tools.ohrt.dev"
                width="360"
                height="54"
              />
            </picture>
          </a>
        </div>
      </div>
      <nav class="bar" aria-label="Sites">
        <div class="bar-inner">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
            projects
          </a>
          <a href="https://blog.ohrt.dev">weblog</a>
          <a href="https://ohrt.dev">ohrt.dev</a>
          <a class="end" href="https://status.ohrt.dev">
            status
          </a>
        </div>
      </nav>
      {Astro.slots.has('sections') && (
        <nav class="strip" aria-label="On this page">
          <div class="strip-inner">
            <slot name="sections" />
          </div>
        </nav>
      )}
    </header>
    <div class="wrapper">
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --page: #ebebeb;
    --strip: #f5f5f5;
    --line: #e0e0e0;
    --ink: #141414;
    --dim: #4f4f4f;
    --muted: #6f6f6f;
    --link: #1474b8;
    --link-hover: #0f578a;
  }

  *,
  ::before,
  ::after {
    box-sizing: border-box;
  }

  /* the root colour shows when you overscroll and tints iOS Safari's bars: header blue near the top, page grey below */
  html {
    background: var(--page);
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  @supports (animation-timeline: scroll()) {
    html {
      animation: overscroll linear both;
    }

    /* separate rule so the minifier can't fold the timeline into the shorthand, which browsers reject */
    :root {
      animation-timeline: scroll(root);
    }
  }

  @keyframes overscroll {
    0%,
    49.9% {
      background-color: #3a587a;
    }

    50%,
    100% {
      background-color: #ebebeb;
    }
  }

  body {
    margin: 0;
    /* the grey as an image, not a colour: WebKit ignores body images when it picks the page colour, so html's wins */
    background: linear-gradient(var(--page), var(--page));
    color: var(--ink);
    font:
      0.9375rem / 1.4 'Segoe UI',
      'Helvetica Neue',
      Helvetica,
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      'Fira Sans',
      'Droid Sans',
      sans-serif;
    overflow-wrap: break-word;
  }

  a {
    color: var(--link);
    text-decoration: none;
  }

  a:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-weight: 400;
  }

  .banner-inner,
  .bar-inner,
  .strip-inner,
  .wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 10px;
  }

  .banner {
    height: 75px;
    background: #3a587a;
    border-bottom: 1px solid #1d2a42;
  }

  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    flex: 0 1 288px;
    min-width: 0;
    /* puts the t's stem on the open tab's left edge */
    margin-left: -7px;
  }

  .chrome {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.5));
  }

  .bar {
    background: linear-gradient(to bottom, #6c94c6 0%, #4c6fab 50%, #44617d 51%, #5674ae 100%);
  }

  .bar-inner {
    display: flex;
    align-items: flex-end;
  }

  .bar a {
    padding: 8px 15px;
    color: #fff;
    text-decoration: none;
    transition: background-color 0.25s ease;
  }

  .bar a:hover {
    background: rgb(255 255 255 / 0.12);
  }

  /* the open tab takes the strip's colour, so the two read as one surface */
  .bar a[aria-current='page'] {
    border-radius: 2px 2px 0 0;
    background: var(--strip);
    color: var(--ink);
    font-weight: 700;
  }

  .bar .end {
    margin-left: auto;
    padding-inline: 10px;
  }

  .strip {
    border-bottom: 1px solid #ccc;
    background: var(--strip);
    font-size: 0.8125rem;
  }

  /* 2px here plus 8px on each link puts the first link's text on the page's left edge */
  .strip-inner {
    padding-inline: 2px;
  }

  .strip a {
    display: inline-block;
    padding: 6px 8px;
    color: var(--ink);
  }

  .strip a:hover {
    color: var(--link-hover);
  }

  .bar a:focus-visible,
  .strip a:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: -3px;
  }

  .wrapper {
    min-height: 60vh;
    padding-top: 10px;
    padding-bottom: 20px;
  }

  @media (max-width: 650px) {
    .banner {
      height: 55px;
    }

    .logo {
      flex-basis: 208px;
      margin-left: -5px;
    }
  }

  @media (max-width: 340px) {
    .bar a {
      padding-inline: 11px;
    }
  }
</style>
