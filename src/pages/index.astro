---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { fetchHealth, STATUS_PAGE } from '../lib/status';

const all = (await getCollection('projects')).sort((a, b) => b.data.started.getTime() - a.data.started.getTime());
const main = all.filter((p) => !p.data.wip);
const health = await fetchHealth(main.flatMap((p) => (p.data.monitor ? [p.data.monitor] : [])));
const swirl = (tag: string) => ({ UP: 'green', DOWN: 'red' })[health[tag] as 'UP' | 'DOWN'] ?? 'yellow';
const years = [...new Set(main.map((p) => p.data.started.getUTCFullYear()))];
const when = (d: Date) => d.toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const day = (d: Date) =>
  d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const fit = (images: ImageMetadata[], maxHeight = 36, maxWidth = 150, gap = 3) => {
  const ratios = images.map((i) => i.width / i.height);
  const height = Math.min(maxHeight, (maxWidth - gap * (images.length - 1)) / ratios.reduce((a, b) => a + b));
  return images.map((src, i) => ({ src, width: Math.round(height * ratios[i]), height: Math.round(height) }));
};
const built = new Date().toLocaleString('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Chicago',
});
---

<Layout title="tools.ohrt.dev">
  <Fragment slot="sections">
    {years.map((year) => (
      <a href={`#${year}`}>{year}</a>
    ))}
  </Fragment>
  <p class="intro">Some things I have built organized chronologically:</p>
  {years.map((year) => (
    <section class="block" id={String(year)}>
      <h2 class="block-header">
        <a href={`#${year}`}>{year} Projects</a>
      </h2>
      <ol>
        {main
          .filter((p) => p.data.started.getUTCFullYear() === year)
          .map(({ data: p }) => (
            <li>
              {p.archived && (
                <div class="archived">
                  This repo was set as a public archive on {day(p.archived)}. It is now read-only.
                </div>
              )}
              <div class="node">
                <div class="node-main">
                  <h3>{p.repo ? <a href={p.repo}>{p.title}</a> : p.title}</h3>
                  <span class="sub">
                    {p.language}, {when(p.started)}
                  </span>
                  <p>{p.description}</p>
                  <div class="links">
                    {p.repo && (
                      <a href={p.repo} target="_blank" rel="noopener">
                        source
                      </a>
                    )}
                    {p.monitor && (
                      <a href={STATUS_PAGE} target="_blank" rel="noopener">
                        status
                        <img
                          class="swirl"
                          src={`/images/swirl-${swirl(p.monitor)}.gif`}
                          width="20"
                          height="20"
                          alt={(health[p.monitor] ?? 'unknown').toLowerCase()}
                          title={(health[p.monitor] ?? 'unknown').toLowerCase()}
                        />
                      </a>
                    )}
                    {p.writeup && (
                      <a href={p.writeup} target="_blank" rel="noopener">
                        writeup
                      </a>
                    )}
                  </div>
                </div>
                {p.images && (
                  <div class="node-extra">
                    <div class="media">
                      {fit(p.images).map((img) => (
                        <Image {...img} alt="" densities={[1, 2]} />
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </li>
          ))}
      </ol>
    </section>
  ))}
  <p class="colophon">
    Built with <a href="https://astro.build">Astro</a>, rebuilt by GitHub Actions every push, last on {built}. Status
    from <a href="https://status.ohrt.dev">status.ohrt.dev</a>.{' '}
    <a href="https://github.com/Lavanic/tools.ohrt.dev">Source</a>.<span class="load-time" hidden></span>
  </p>
</Layout>

<script>
  const line = document.querySelector<HTMLElement>('.load-time');
  const show = () => {
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const ms = nav ? nav.loadEventEnd - nav.startTime : 0;
    if (!line || !(ms > 0)) return;
    line.textContent = `This page loaded for you in ${Math.round(ms)} ms.`;
    line.hidden = false;
  };
  if (document.readyState === 'complete') setTimeout(show);
  else addEventListener('load', () => setTimeout(show), { once: true });
</script>

<style>
  .intro {
    margin: 0 0 10px;
    color: var(--dim);
  }

  .block {
    margin-bottom: 20px;
    border: 1px solid;
    border-color: #e0e0e0 #d6d6d6 #ccc;
    border-radius: 4px;
    background: #fff;
    scroll-margin-top: 10px;
  }

  .block-header {
    padding: 6px 10px;
    border-bottom: 1px solid var(--line);
    border-radius: 3px 3px 0 0;
    background: linear-gradient(0deg, #e8f4fc, #fff);
    color: var(--link);
    font-size: 1.25rem;
  }

  .block-header a {
    color: inherit;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  .archived {
    padding: 1px 16px;
    border-bottom: 1px solid rgb(212 167 44 / 0.4);
    background: #fff8c5;
    color: rgb(31 35 40 / 0.7);
    font-size: 12px;
    font-weight: 600;
    line-height: 18px;
    text-align: center;
  }

  .node {
    display: flex;
    align-items: center;
  }

  .node-main {
    flex: 1;
    min-width: 0;
    padding: 10px;
  }

  h3 {
    display: inline;
    font-size: 1.0625rem;
  }

  .sub {
    margin-left: 6px;
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .node-main p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--dim);
  }

  .links {
    margin-top: 0.3em;
    font-size: 0.8125rem;
  }

  .links > * + * {
    margin-left: 12px;
  }

  .swirl {
    width: 20px;
    height: 20px;
    /* pulled in top and bottom so the swirl doesn't make its line taller than the others */
    margin: -2px 0 -2px 3px;
    vertical-align: -5px;
    image-rendering: pixelated;
  }

  .node-extra {
    flex: none;
    width: 280px;
    padding: 10px;
    font-size: 0.8125rem;
  }

  .media {
    display: flex;
    justify-content: flex-end;
    gap: 3px;
  }

  .media :global(img) {
    display: block;
    box-sizing: content-box;
    border: 1px solid var(--line);
    background: #fff;
  }

  .colophon {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--dim);
  }

  .load-time {
    display: block;
    margin-top: 4px;
  }

  .load-time[hidden] {
    display: none;
  }

  @media (max-width: 650px) {
    /* blocks run edge to edge on a phone */
    .block {
      margin-inline: -10px;
      border-inline: 0;
      border-radius: 0;
    }

    .block-header {
      border-radius: 0;
    }

    .archived {
      padding: 1px 6px;
      /* scales with the screen so the sentence stays on one line */
      font-size: min(12px, calc((100vw - 12px) / 36));
    }

    .node {
      flex-wrap: wrap;
    }

    .node-extra {
      flex-basis: 100%;
      padding-top: 0;
    }

    .media {
      justify-content: flex-start;
    }
  }
</style>
