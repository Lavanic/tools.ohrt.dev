---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Thumbnail from '../components/Thumbnail.astro';
import Viewer from '../components/Viewer.astro';
import Layout from '../layouts/Layout.astro';
import { fetchRepos, type Repo } from '../lib/github';
import { icon } from '../lib/icons';

const all = (await getCollection('projects')).sort((a, b) => b.data.started.getTime() - a.data.started.getTime());
const main = all.filter((p) => !p.data.wip);
const sources = (p: { repo?: string; also?: string[] }) =>
  [p.repo, ...(p.also ?? [])].filter((url) => url !== undefined);
const repos = await fetchRepos(main.flatMap((p) => sources(p.data)));
// a project spread over several repos counts them all and shows whichever moved last
const together = (found: Repo[]): Repo | undefined =>
  found.length === 0
    ? undefined
    : {
        stars: found.reduce((n, repo) => n + repo.stars, 0),
        commits: found.reduce((n, repo) => n + repo.commits, 0),
        last: found
          .flatMap((repo) => (repo.last ? [repo.last] : []))
          .sort((a, b) => Date.parse(b.date) - Date.parse(a.date))[0],
      };
const projects = main.map(({ data: p }) => ({
  p,
  repo: together(sources(p).flatMap((url) => (repos[url] ? [repos[url]] : []))),
}));
// each project's newest commit, newest first; ones with no person behind them (the door counter's sync bot) stay out
const recent = projects
  .flatMap(({ p, repo }) => (repo?.last?.author ? [{ p, commit: repo.last }] : []))
  .sort((a, b) => Date.parse(b.commit.date) - Date.parse(a.commit.date))
  .slice(0, 5);
const count = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
const exact = new Intl.NumberFormat('en-US');
const known = projects.flatMap(({ repo }) => (repo ? [repo] : []));
const sum = (pick: (repo: (typeof known)[number]) => number) =>
  exact.format(known.reduce((n, repo) => n + pick(repo), 0));
// where a title leads: the code, or the write-up of a project whose code is not public
const home = (p: { repo?: string; writeup?: string }) => p.repo ?? p.writeup;
const years = [...new Set(main.map((p) => p.data.started.getUTCFullYear()))];
const when = (d: Date) => d.toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const day = (d: Date) =>
  d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
type Shot = { src: ImageMetadata; poster?: ImageMetadata; preview?: ImageMetadata; caption?: string };
// a thumbnail is drawn from the picture itself, or from its poster when the picture is an animation
const fit = (shots: Shot[], maxHeight = 36, maxWidth = 150, gap = 3) => {
  const ratios = shots.map(({ src, poster = src }) => poster.width / poster.height);
  const height = Math.min(maxHeight, (maxWidth - gap * (shots.length - 1)) / ratios.reduce((a, b) => a + b));
  return shots.map((shot, i) => ({ ...shot, width: Math.round(height * ratios[i]), height: Math.round(height) }));
};
---

<Layout title="tools.ohrt.dev">
  <Fragment slot="sections">
    {years.map((year) => (
      <a href={`#${year}`}>{year}</a>
    ))}
  </Fragment>
  <p class="intro">Some things I have built organized chronologically by start date:</p>
  <div class="columns">
    <div class="content">
      {years.map((year) => (
        <section class="block" id={String(year)}>
          <h2 class="block-header">
            <a href={`#${year}`}>{year}</a>
          </h2>
          <ol>
            {projects
              .filter(({ p }) => p.started.getUTCFullYear() === year)
              .map(({ p, repo }) => (
                <li>
                  <div class="node">
                    <span class="node-icon" aria-hidden="true" set:html={icon(p.icon)} />
                    <div class="node-main">
                      <div class="node-title">
                        <h3>{home(p) ? <a href={home(p)}>{p.title}</a> : p.title}</h3>
                        <span class="sub">
                          {p.language}, {when(p.started)}
                        </span>
                        {p.award && <span class="badge">{p.award}</span>}
                        {p.archived && (
                          <span class="label">
                            This repo was set as a public archive on {day(p.archived)}. It is now read-only.
                          </span>
                        )}
                      </div>
                      <p>{p.description}</p>
                      <div class="links">
                        {p.repo && (
                          <a href={p.repo} target="_blank" rel="noopener">
                            source
                          </a>
                        )}
                        {p.monitor && (
                          <a href="https://status.ohrt.dev" target="_blank" rel="noopener">
                            status
                          </a>
                        )}
                        {p.writeup && (
                          <a href={p.writeup} target="_blank" rel="noopener">
                            {new URL(p.writeup).hostname === 'devpost.com' ? 'devpost' : 'writeup'}
                          </a>
                        )}
                        {repo && (
                          <span class="stats-inline">
                            Stars {count.format(repo.stars)} · Commits {count.format(repo.commits)}
                          </span>
                        )}
                      </div>
                    </div>
                    {repo && (
                      <div class="node-stats">
                        <dl>
                          <dt>Stars</dt>
                          <dd>{count.format(repo.stars)}</dd>
                        </dl>
                        <dl>
                          <dt>Commits</dt>
                          <dd>{count.format(repo.commits)}</dd>
                        </dl>
                      </div>
                    )}
                    {(p.images || repo?.last) && (
                      <div class="node-extra">
                        {p.images && (
                          <div
                            class="media"
                            data-title={p.title}
                            data-sub={`${p.language}, ${when(p.started)}`}
                            data-href={home(p)}
                          >
                            {fit(p.images).map(({ src, poster, preview, caption, width, height }, i, all) => (
                              <a
                                href={src.src}
                                aria-label={caption ?? `${p.title} ${i + 1}/${all.length}`}
                                data-w={src.width}
                                data-h={src.height}
                                data-caption={caption}
                                data-animated={!!poster || undefined}
                              >
                                <Thumbnail src={poster ?? src} preview={preview} width={width} height={height} />
                              </a>
                            ))}
                          </div>
                        )}
                        {repo?.last && (
                          <>
                            <a
                              class="commit"
                              href={repo.last.url}
                              title={repo.last.message}
                              target="_blank"
                              rel="noopener"
                            >
                              {repo.last.message}
                            </a>
                            <div class="commit-meta">
                              <time datetime={repo.last.date}>{day(new Date(repo.last.date))}</time>
                              <span class="sha">{repo.last.sha.slice(0, 7)}</span>
                            </div>
                          </>
                        )}
                      </div>
                    )}
                  </div>
                </li>
              ))}
          </ol>
        </section>
      ))}
    </div>
    <aside class="sidebar">
      {recent.length > 0 && (
        <section class="block">
          <h2 class="block-minor">Recent commits</h2>
          <ul class="log">
            {recent.map(({ p, commit }) => (
              <li>
                <div class="minor">
                  <time datetime={commit.date}>{day(new Date(commit.date))}</time> :{' '}
                  <a href={commit.url} target="_blank" rel="noopener">
                    {commit.sha.slice(0, 7)}
                  </a>
                </div>
                <span class="minor-name">{p.title}</span> {commit.message}
              </li>
            ))}
          </ul>
          <p class="block-foot">
            <a href="https://github.com/Lavanic?tab=repositories" target="_blank" rel="noopener">
              see the rest
            </a>
          </p>
        </section>
      )}
      <section class="block">
        <h2 class="block-minor">Statistics</h2>
        <div class="pairs">
          <dl>
            <dt>Projects</dt>
            <dd>{projects.length}</dd>
          </dl>
          {known.length > 0 && (
            <>
              <dl>
                <dt>Stars</dt>
                <dd>{sum((repo) => repo.stars)}</dd>
              </dl>
              <dl>
                <dt>Commits</dt>
                <dd>{sum((repo) => repo.commits)}</dd>
              </dl>
            </>
          )}
          <dl>
            <dt>Latest project</dt>
            <dd>
              {home(projects[0].p) ? <a href={home(projects[0].p)}>{projects[0].p.title}</a> : projects[0].p.title}
            </dd>
          </dl>
        </div>
      </section>
    </aside>
  </div>
  <Viewer />
</Layout>

<style>
  .intro {
    margin: 0 0 10px;
    color: var(--dim);
  }

  /* the projects, and beside them a sidebar the width of the forum's */
  .columns {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .content {
    flex: 1;
    min-width: 0;
  }

  .sidebar {
    flex: none;
    width: 250px;
  }

  .block {
    scroll-margin-top: 10px;
  }

  .block-header {
    padding: 6px 10px;
    border-bottom: 1px solid var(--line);
    border-radius: 3px 3px 0 0;
    background: linear-gradient(0deg, #e8f4fc, #fff);
    color: var(--link);
    font-size: 1.25rem;
  }

  .block-header a {
    color: inherit;
  }

  .block-minor {
    padding: 6px 10px;
    color: var(--link);
    font-size: 1.0625rem;
  }

  ol,
  .log {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* plain text, in the manner of the changelog on ohrt.dev: date and hash, then what changed */
  .log {
    padding: 0 10px 4px;
    font-size: 0.8125rem;
  }

  .log li {
    padding-bottom: 6px;
  }

  .minor-name {
    color: var(--muted);
  }

  .block-foot {
    margin: 0;
    padding: 6px 10px;
    border-top: 1px solid var(--line);
    border-radius: 0 0 3px 3px;
    background: linear-gradient(180deg, #f5f5f5, #fafafa);
    color: var(--dim);
    font-size: 0.75rem;
  }

  .minor {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .pairs {
    padding: 6px 10px;
  }

  .pairs dl {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    margin: 0;
  }

  .pairs dt {
    color: var(--muted);
  }

  .pairs dt::after {
    content: ':';
  }

  .pairs dd {
    margin: 0;
    text-align: right;
  }

  ol > li + li {
    border-top: 1px solid var(--line);
  }

  /* a row knows its own width, to place its archive notice */
  ol > li {
    container-type: inline-size;
  }

  .node {
    --stats: 140px;
    --extra: 280px;
    display: flex;
    align-items: center;
  }

  .node-icon {
    flex: none;
    width: 46px;
    padding-left: 10px;
    color: #c6e4f9;
  }

  .node-icon :global(svg) {
    display: block;
    width: 36px;
    height: 36px;
  }

  .node-main {
    flex: 1;
    min-width: 0;
    padding: 10px;
  }

  /* the gaps trail each piece, so one that wraps to a new line starts flush with the text */
  .node-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
  }

  h3 {
    margin-right: 6px;
    font-size: 1.0625rem;
  }

  .sub {
    margin-right: 6px;
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* in the manner of a forum's thread prefix */
  .badge {
    --pad: 1px;
    margin-right: 6px;
    padding: calc(var(--pad) + 1px) 0.35em var(--pad);
    border: 1px solid #c6e4f9;
    border-radius: 2px;
    background: #e8f4fc;
    color: var(--link-hover);
    font-size: 0.75rem;
    line-height: 1.26;
    white-space: nowrap;
  }

  /* the archive notice, in the pale yellow of GitHub's, reaching the far edge of the row */
  .label {
    --pad: 1px;
    --reach: calc(var(--stats) + var(--extra) + 10px);
    overflow: hidden;
    margin-right: calc(-1 * var(--reach));
    padding: var(--pad) 6px;
    border: solid rgb(212 167 44 / 0.4);
    background: #fff8c5;
    color: rgb(31 35 40 / 0.7);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.26;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* trimmed to its capitals, the sentence sits in the middle of the band whatever the font */
  @supports (text-box: trim-both cap alphabetic) {
    .label {
      --pad: 4px;
      text-box: trim-both cap alphabetic;
    }

    .badge {
      padding-block: 4px;
      text-box: trim-both cap alphabetic;
    }
  }

  /* with room beside the title it is a band from the date on, and what stands beside the title moves under it */
  @container (width > 760px) {
    .label {
      flex: 1;
      border-width: 1px 0;
    }

    .node:has(.label) > :is(.node-stats, .node-extra) {
      align-self: flex-end;
      padding-top: 0;
    }

    .node:has(.label) > .node-stats {
      padding-bottom: 10px;
    }
  }

  /* without, it lies across the top of the row, as small as it takes to stay on one line */
  @container (width <= 760px) {
    .label {
      order: -1;
      flex: none;
      width: calc(100% + 56px + var(--reach));
      margin: -10px calc(-1 * var(--reach)) 10px -56px;
      padding-block: calc(var(--pad) + 2px);
      border-width: 0 0 1px;
      font-size: min(0.75rem, (100cqw - 12px) / 36);
    }
  }

  .node-main p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--dim);
  }

  .links {
    margin-top: 0.3em;
    font-size: 0.8125rem;
  }

  .links > * + * {
    margin-left: 12px;
  }

  .stats-inline {
    display: none;
    color: var(--muted);
  }

  .node-stats {
    display: flex;
    flex: none;
    width: var(--stats);
    text-align: center;
  }

  .node-stats dl {
    flex: 1;
    margin: 0;
    padding: 0 3px;
  }

  .node-stats dt {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .node-stats dd {
    margin: 0;
  }

  .node-extra {
    flex: none;
    width: var(--extra);
    padding: 10px;
    font-size: 0.8125rem;
  }

  .media {
    display: flex;
    float: right;
    gap: 3px;
    margin-left: 10px;
  }

  /* one line, cut with an ellipsis, like the forum's last post */
  .commit {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* one line as well: when thumbnails leave no room for the hash it wraps out of sight whole, instead of being cut mid-way */
  .commit-meta {
    display: flex;
    flex-wrap: wrap;
    height: 1.4em;
    overflow: hidden;
    color: var(--muted);
    white-space: nowrap;
  }

  .sha::before {
    margin: 0 0.35em;
    content: '·';
  }

  .media a {
    cursor: zoom-in;
  }

  .media :global(img) {
    display: block;
    box-sizing: content-box;
    border: 1px solid var(--line);
    background: #fff;
  }

  .media a:hover :global(img) {
    border-color: var(--link);
  }

  /* no room for the two columns beside the sidebar: the numbers move into the line of links */
  @media (max-width: 1100px) {
    .node {
      --stats: 0px;
    }

    .node-stats {
      display: none;
    }

    .stats-inline {
      display: inline;
    }
  }

  /* the sidebar drops under the projects, its blocks side by side */
  @media (max-width: 1000px) {
    .columns {
      display: block;
    }

    .sidebar {
      display: flex;
      flex-wrap: wrap;
      gap: 0 10px;
      width: auto;
    }

    .sidebar > * {
      flex: 1 1 250px;
    }
  }

  @media (max-width: 650px) {
    .block-header {
      border-radius: 0;
      font-size: 1.125rem;
    }

    .sidebar {
      display: block;
    }

    .node {
      --extra: 0px;
      flex-wrap: wrap;
    }

    h3 {
      font-size: 1rem;
    }

    /* under the text, not under the icon; the thumbnails keep their place at its right */
    .node-extra {
      flex-basis: 100%;
      margin-top: -4px;
      padding: 0 10px 10px 56px;
    }
  }
</style>
