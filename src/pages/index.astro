---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { fetchHealth, STATUS_PAGE } from '../lib/status';

const all = (await getCollection('projects')).sort((a, b) => b.data.started.getTime() - a.data.started.getTime());
const main = all.filter((p) => !p.data.wip);
const health = await fetchHealth(main.flatMap((p) => (p.data.monitor ? [p.data.monitor] : [])));
const swirl = (tag: string) => ({ UP: 'green', DOWN: 'red' })[health[tag] as 'UP' | 'DOWN'] ?? 'yellow';
const years = [...new Set(main.map((p) => p.data.started.getUTCFullYear()))];
const when = (d: Date) => d.toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const day = (d: Date) =>
  d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const fit = (images: ImageMetadata[], maxHeight = 88, maxWidth = 240, gap = 3) => {
  const ratios = images.map((i) => i.width / i.height);
  const height = Math.min(maxHeight, (maxWidth - gap * (images.length - 1)) / ratios.reduce((a, b) => a + b));
  return images.map((src, i) => ({ src, width: Math.round(height * ratios[i]), height: Math.round(height) }));
};
const built = new Date().toLocaleString('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Chicago',
});
---

<Layout title="tools.ohrt.dev">
  <p class="intro">Some things I have built organized chronologically:</p>
  {years.map((year) => (
    <section>
      <h2 class="year">{year}</h2>
      <ol>
        {main
          .filter((p) => p.data.started.getUTCFullYear() === year)
          .map(({ data: p }) => (
            <li>
              {p.archived && (
                <div class="archived">
                  This repo was set as a public archive on {day(p.archived)}. It is now read-only.
                </div>
              )}
              <div class="row">
                <h3>{p.repo ? <a href={p.repo}>{p.title}</a> : p.title}</h3>
                <span class="sub">
                  {p.language}, {when(p.started)}
                </span>
                <span class="links">
                  {p.repo && (
                    <a href={p.repo} target="_blank" rel="noopener">
                      source
                    </a>
                  )}
                  {p.monitor && (
                    <a href={STATUS_PAGE} target="_blank" rel="noopener">
                      status
                      <img
                        class="swirl"
                        src={`/images/swirl-${swirl(p.monitor)}.gif`}
                        width="20"
                        height="20"
                        alt={(health[p.monitor] ?? 'unknown').toLowerCase()}
                        title={(health[p.monitor] ?? 'unknown').toLowerCase()}
                      />
                    </a>
                  )}
                  {p.writeup && (
                    <a href={p.writeup} target="_blank" rel="noopener">
                      writeup
                    </a>
                  )}
                </span>
              </div>
              <div class:list={['body', { stack: (p.images?.length ?? 0) > 1 }]}>
                <p>{p.description}</p>
                {p.images && (
                  <div class="media">
                    {fit(p.images).map((img) => (
                      <Image {...img} alt="" densities={[1, 2]} />
                    ))}
                  </div>
                )}
              </div>
            </li>
          ))}
      </ol>
    </section>
  ))}
  <p class="colophon">
    Built with <a href="https://astro.build">Astro</a>, rebuilt by GitHub Actions every push, last on {built}. Status
    from <a href="https://status.ohrt.dev">status.ohrt.dev</a>.{' '}
    <a href="https://github.com/Lavanic/tools.ohrt.dev">Source</a>.<span class="load-time" hidden></span>
  </p>
</Layout>

<script>
  const line = document.querySelector<HTMLElement>('.load-time');
  const show = () => {
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const ms = nav ? nav.loadEventEnd - nav.startTime : 0;
    if (!line || !(ms > 0)) return;
    line.textContent = `This page loaded for you in ${Math.round(ms)} ms.`;
    line.hidden = false;
  };
  if (document.readyState === 'complete') setTimeout(show);
  else addEventListener('load', () => setTimeout(show), { once: true });
</script>

<style>
  .intro {
    margin: 0 0 10px;
    font-size: 15px;
    color: #6b7486;
  }

  .year {
    margin: 16px 0 4px;
    font-size: 15px;
    letter-spacing: 2px;
    color: #6b7486;
  }

  section:first-of-type .year {
    margin-top: 0;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 12px 0 10px;
    border-top: 1px solid #e6e1d6;
  }

  section:last-of-type li:last-child {
    border-bottom: 1px solid #e6e1d6;
  }

  .archived {
    margin: 0 0 6px;
    padding: 1px 16px;
    border-block: 1px solid rgb(212 167 44 / 0.4);
    background: #fff8c5;
    color: rgb(31 35 40 / 0.7);
    font-size: 12px;
    font-weight: 600;
    line-height: 18px;
    text-align: center;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
  }

  h3 {
    font-size: 21px;
    letter-spacing: 0.3px;
    color: #172238;
    white-space: nowrap;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  .sub {
    font-family: georgia, serif;
    font-size: 15px;
    font-style: italic;
    letter-spacing: 0;
    color: #6b7486;
    white-space: nowrap;
  }

  .links {
    margin-left: auto;
    font-size: 14px;
    white-space: nowrap;
  }

  .links > * + * {
    margin-left: 12px;
  }

  .swirl {
    width: 20px;
    height: 20px;
    margin-left: 3px;
    vertical-align: -5px;
    image-rendering: pixelated;
  }

  li p {
    max-width: 60ch;
    margin: 6px 0 0;
    font-size: 16px;
  }

  .body {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .media {
    display: flex;
    flex: none;
    gap: 3px;
    margin: 8px 0 0 auto;
  }

  .media :global(img) {
    display: block;
    border: 1px solid #e2ddd1;
    background: #fff;
  }

  .colophon {
    margin: 24px 0 0;
    font-size: 13px;
    color: #6b7486;
  }

  .load-time {
    display: block;
    margin-top: 4px;
  }

  .load-time[hidden] {
    display: none;
  }

  @media (max-width: 47rem) {
    .archived {
      padding: 1px 6px;
      /* scales with the screen so the sentence stays on one line */
      font-size: min(12px, calc((100vw - 68px) / 36));
    }

    .sub {
      order: 1;
      flex-basis: 100%;
    }

    .stack {
      flex-direction: column;
      gap: 0;
    }

    .stack .media {
      margin: 10px 0 0;
    }
  }
</style>
