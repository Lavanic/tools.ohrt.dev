---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { fetchRepos } from '../lib/github';

const all = (await getCollection('projects')).sort((a, b) => b.data.started.getTime() - a.data.started.getTime());
const main = all.filter((p) => !p.data.wip);
const repos = await fetchRepos(main.flatMap((p) => (p.data.repo ? [p.data.repo] : [])));
const count = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
const years = [...new Set(main.map((p) => p.data.started.getUTCFullYear()))];
const when = (d: Date) => d.toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const day = (d: Date) =>
  d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const icons = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const icon = (name: string) => {
  const svg = icons[`../icons/${name}.svg`];
  if (!svg) throw new Error(`no icon named "${name}" in src/icons`);
  return svg;
};
const fit = (images: ImageMetadata[], maxHeight = 36, maxWidth = 150, gap = 3) => {
  const ratios = images.map((i) => i.width / i.height);
  const height = Math.min(maxHeight, (maxWidth - gap * (images.length - 1)) / ratios.reduce((a, b) => a + b));
  return images.map((src, i) => ({ src, width: Math.round(height * ratios[i]), height: Math.round(height) }));
};
const built = new Date().toLocaleString('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Chicago',
});
---

<Layout title="tools.ohrt.dev">
  <Fragment slot="sections">
    {years.map((year) => (
      <a href={`#${year}`}>{year}</a>
    ))}
  </Fragment>
  <p class="intro">Some things I have built organized chronologically:</p>
  {years.map((year) => (
    <section class="block" id={String(year)}>
      <h2 class="block-header">
        <a href={`#${year}`}>{year} Projects</a>
      </h2>
      <ol>
        {main
          .filter((p) => p.data.started.getUTCFullYear() === year)
          .map(({ data: p }) => ({ p, repo: p.repo ? repos[p.repo] : undefined }))
          .map(({ p, repo }) => (
            <li>
              <div class="node">
                <span class="node-icon" aria-hidden="true" set:html={icon(p.icon)} />
                <div class="node-main">
                  <h3>{p.repo ? <a href={p.repo}>{p.title}</a> : p.title}</h3>
                  <span class="sub">
                    {p.language}, {when(p.started)}
                  </span>
                  {p.archived && (
                    <span
                      class="label"
                      title={`This repo was set as a public archive on ${day(p.archived)}. It is now read-only.`}
                    >
                      Public archive
                    </span>
                  )}
                  <p>{p.description}</p>
                  <div class="links">
                    {p.repo && (
                      <a href={p.repo} target="_blank" rel="noopener">
                        source
                      </a>
                    )}
                    {p.monitor && (
                      <a href="https://status.ohrt.dev" target="_blank" rel="noopener">
                        status
                      </a>
                    )}
                    {p.writeup && (
                      <a href={p.writeup} target="_blank" rel="noopener">
                        writeup
                      </a>
                    )}
                    {repo && (
                      <span class="stats-inline">
                        Stars {count.format(repo.stars)} · Commits {count.format(repo.commits)}
                      </span>
                    )}
                  </div>
                </div>
                {repo && (
                  <div class="node-stats">
                    <dl>
                      <dt>Stars</dt>
                      <dd>{count.format(repo.stars)}</dd>
                    </dl>
                    <dl>
                      <dt>Commits</dt>
                      <dd>{count.format(repo.commits)}</dd>
                    </dl>
                  </div>
                )}
                {(p.images || repo?.last) && (
                  <div class="node-extra">
                    {p.images && (
                      <div class="media">
                        {fit(p.images).map((img, i, all) => (
                          <a href={img.src.src} aria-label={`${p.title} ${i + 1}/${all.length}`}>
                            <Image {...img} alt="" densities={[1, 2]} />
                          </a>
                        ))}
                      </div>
                    )}
                    {repo?.last && (
                      <>
                        <a class="commit" href={repo.last.url} title={repo.last.message} target="_blank" rel="noopener">
                          {repo.last.message}
                        </a>
                        <div class="commit-meta">
                          <time datetime={repo.last.date}>{day(new Date(repo.last.date))}</time> ·{' '}
                          {repo.last.sha.slice(0, 7)}
                        </div>
                      </>
                    )}
                  </div>
                )}
              </div>
            </li>
          ))}
      </ol>
    </section>
  ))}
  <p class="colophon">
    Built with <a href="https://astro.build">Astro</a>, rebuilt by GitHub Actions every push, last on {built}. Status
    from <a href="https://status.ohrt.dev">status.ohrt.dev</a>.{' '}
    <a href="https://github.com/Lavanic/tools.ohrt.dev">Source</a>.<span class="load-time" hidden></span>
  </p>
</Layout>

<script>
  const line = document.querySelector<HTMLElement>('.load-time');
  const show = () => {
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const ms = nav ? nav.loadEventEnd - nav.startTime : 0;
    if (!line || !(ms > 0)) return;
    line.textContent = `This page loaded for you in ${Math.round(ms)} ms.`;
    line.hidden = false;
  };
  if (document.readyState === 'complete') setTimeout(show);
  else addEventListener('load', () => setTimeout(show), { once: true });
</script>

<style>
  .intro {
    margin: 0 0 10px;
    color: var(--dim);
  }

  .block {
    margin-bottom: 20px;
    border: 1px solid;
    border-color: #e0e0e0 #d6d6d6 #ccc;
    border-radius: 4px;
    background: #fff;
    scroll-margin-top: 10px;
  }

  .block-header {
    padding: 6px 10px;
    border-bottom: 1px solid var(--line);
    border-radius: 3px 3px 0 0;
    background: linear-gradient(0deg, #e8f4fc, #fff);
    color: var(--link);
    font-size: 1.25rem;
  }

  .block-header a {
    color: inherit;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  .node {
    display: flex;
    align-items: center;
  }

  .node-icon {
    flex: none;
    width: 46px;
    padding-left: 10px;
    color: #c6e4f9;
  }

  .node-icon :global(svg) {
    display: block;
    width: 36px;
    height: 36px;
  }

  .node-main {
    flex: 1;
    min-width: 0;
    padding: 10px;
  }

  /* the gaps trail each piece, so one that wraps to a new line starts flush with the text */
  h3 {
    display: inline;
    margin-right: 6px;
    font-size: 1.0625rem;
  }

  .sub {
    margin-right: 6px;
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* the pale yellow of GitHub's archive notice */
  .label {
    display: inline-block;
    padding: 1px 0.45em;
    border: 1px solid rgb(212 167 44 / 0.6);
    border-radius: 4px;
    background: #fff8c5;
    color: rgb(31 35 40 / 0.75);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.26;
    white-space: nowrap;
    vertical-align: 1px;
  }

  .node-main p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--dim);
  }

  .links {
    margin-top: 0.3em;
    font-size: 0.8125rem;
  }

  .links > * + * {
    margin-left: 12px;
  }

  .stats-inline {
    display: none;
    color: var(--muted);
  }

  .node-stats {
    display: flex;
    flex: none;
    width: 140px;
    text-align: center;
  }

  .node-stats dl {
    flex: 1;
    margin: 0;
    padding: 0 3px;
  }

  .node-stats dt {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .node-stats dd {
    margin: 0;
  }

  .node-extra {
    flex: none;
    width: 280px;
    padding: 10px;
    font-size: 0.8125rem;
  }

  .media {
    display: flex;
    float: right;
    gap: 3px;
    margin-left: 10px;
  }

  /* each on one line, cut with an ellipsis, like the forum's last post */
  .commit,
  .commit-meta {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .commit-meta {
    color: var(--muted);
  }

  .media a {
    cursor: zoom-in;
  }

  .media :global(img) {
    display: block;
    box-sizing: content-box;
    border: 1px solid var(--line);
    background: #fff;
  }

  .media a:hover :global(img) {
    border-color: var(--link);
  }

  .colophon {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--dim);
  }

  .load-time {
    display: block;
    margin-top: 4px;
  }

  .load-time[hidden] {
    display: none;
  }

  /* no room for the two columns: the numbers move into the line of links */
  @media (max-width: 1000px) {
    .node-stats {
      display: none;
    }

    .stats-inline {
      display: inline;
    }
  }

  @media (max-width: 650px) {
    /* blocks run edge to edge on a phone */
    .block {
      margin-inline: -10px;
      border-inline: 0;
      border-radius: 0;
    }

    .block-header {
      border-radius: 0;
    }

    .node {
      flex-wrap: wrap;
    }

    /* under the text, not under the icon */
    .node-extra {
      flex-basis: 100%;
      margin-top: -4px;
      padding: 0 10px 10px 56px;
    }

    .media {
      float: none;
      margin: 0 0 6px;
    }
  }
</style>
