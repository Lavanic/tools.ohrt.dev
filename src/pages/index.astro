---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Viewer from '../components/Viewer.astro';
import Layout from '../layouts/Layout.astro';
import { fetchRepos, type Repo } from '../lib/github';
import { icon } from '../lib/icons';

const all = (await getCollection('projects')).sort((a, b) => b.data.started.getTime() - a.data.started.getTime());
const main = all.filter((p) => !p.data.wip);
const sources = (p: { repo?: string; also?: string[] }) =>
  [p.repo, ...(p.also ?? [])].filter((url) => url !== undefined);
const repos = await fetchRepos(main.flatMap((p) => sources(p.data)));
// a project spread over several repos counts them all and shows whichever moved last
const together = (found: Repo[]): Repo | undefined =>
  found.length === 0
    ? undefined
    : {
        stars: found.reduce((n, repo) => n + repo.stars, 0),
        commits: found.reduce((n, repo) => n + repo.commits, 0),
        last: found
          .flatMap((repo) => (repo.last ? [repo.last] : []))
          .sort((a, b) => Date.parse(b.date) - Date.parse(a.date))[0],
      };
const projects = main.map(({ data: p }) => ({
  p,
  repo: together(sources(p).flatMap((url) => (repos[url] ? [repos[url]] : []))),
}));
// each project's newest commit, newest first; ones with no person behind them (the door counter's sync bot) stay out
const recent = projects
  .flatMap(({ p, repo }) => (repo?.last?.author ? [{ p, commit: repo.last }] : []))
  .sort((a, b) => Date.parse(b.commit.date) - Date.parse(a.commit.date))
  .slice(0, 5);
const count = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
const exact = new Intl.NumberFormat('en-US');
const known = projects.flatMap(({ repo }) => (repo ? [repo] : []));
const sum = (pick: (repo: (typeof known)[number]) => number) =>
  exact.format(known.reduce((n, repo) => n + pick(repo), 0));
const years = [...new Set(main.map((p) => p.data.started.getUTCFullYear()))];
const when = (d: Date) => d.toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const day = (d: Date) =>
  d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const fit = (images: ImageMetadata[], maxHeight = 36, maxWidth = 150, gap = 3) => {
  const ratios = images.map((i) => i.width / i.height);
  const height = Math.min(maxHeight, (maxWidth - gap * (images.length - 1)) / ratios.reduce((a, b) => a + b));
  return images.map((src, i) => ({ src, width: Math.round(height * ratios[i]), height: Math.round(height) }));
};
---

<Layout title="tools.ohrt.dev">
  <Fragment slot="sections">
    {years.map((year) => (
      <a href={`#${year}`}>{year}</a>
    ))}
  </Fragment>
  <p class="intro">Some things I have built organized chronologically by start date:</p>
  <div class="columns">
    <div class="content">
      {years.map((year) => (
        <section class="block" id={String(year)}>
          <h2 class="block-header">
            <a href={`#${year}`}>{year} Projects</a>
          </h2>
          <ol>
            {projects
              .filter(({ p }) => p.started.getUTCFullYear() === year)
              .map(({ p, repo }) => (
                <li>
                  <div class="node">
                    <span class="node-icon" aria-hidden="true" set:html={icon(p.icon)} />
                    <div class="node-main">
                      <h3>{p.repo ? <a href={p.repo}>{p.title}</a> : p.title}</h3>
                      <span class="sub">
                        {p.language}, {when(p.started)}
                      </span>
                      {p.archived && (
                        <span
                          class="label"
                          title={`This repo was set as a public archive on ${day(p.archived)}. It is now read-only.`}
                        >
                          Public archive
                        </span>
                      )}
                      <p>{p.description}</p>
                      <div class="links">
                        {p.repo && (
                          <a href={p.repo} target="_blank" rel="noopener">
                            source
                          </a>
                        )}
                        {p.monitor && (
                          <a href="https://status.ohrt.dev" target="_blank" rel="noopener">
                            status
                          </a>
                        )}
                        {p.writeup && (
                          <a href={p.writeup} target="_blank" rel="noopener">
                            writeup
                          </a>
                        )}
                        {repo && (
                          <span class="stats-inline">
                            Stars {count.format(repo.stars)} · Commits {count.format(repo.commits)}
                          </span>
                        )}
                      </div>
                    </div>
                    {repo && (
                      <div class="node-stats">
                        <dl>
                          <dt>Stars</dt>
                          <dd>{count.format(repo.stars)}</dd>
                        </dl>
                        <dl>
                          <dt>Commits</dt>
                          <dd>{count.format(repo.commits)}</dd>
                        </dl>
                      </div>
                    )}
                    {(p.images || repo?.last) && (
                      <div class="node-extra">
                        {p.images && (
                          <div
                            class="media"
                            data-title={p.title}
                            data-sub={`${p.language}, ${when(p.started)}`}
                            data-href={p.repo}
                          >
                            {fit(p.images).map((img, i, all) => (
                              <a
                                href={img.src.src}
                                aria-label={`${p.title} ${i + 1}/${all.length}`}
                                data-w={img.src.width}
                                data-h={img.src.height}
                              >
                                <Image {...img} alt="" densities={[1, 2]} />
                              </a>
                            ))}
                          </div>
                        )}
                        {repo?.last && (
                          <>
                            <a
                              class="commit"
                              href={repo.last.url}
                              title={repo.last.message}
                              target="_blank"
                              rel="noopener"
                            >
                              {repo.last.message}
                            </a>
                            <div class="commit-meta">
                              <time datetime={repo.last.date}>{day(new Date(repo.last.date))}</time>
                              <span class="sha">{repo.last.sha.slice(0, 7)}</span>
                            </div>
                          </>
                        )}
                      </div>
                    )}
                  </div>
                </li>
              ))}
          </ol>
        </section>
      ))}
    </div>
    <aside class="sidebar">
      {recent.length > 0 && (
        <section class="block">
          <h2 class="block-minor">Recent commits</h2>
          <ul class="log">
            {recent.map(({ p, commit }) => (
              <li>
                <div class="minor">
                  <time datetime={commit.date}>{day(new Date(commit.date))}</time> :{' '}
                  <a href={commit.url} target="_blank" rel="noopener">
                    {commit.sha.slice(0, 7)}
                  </a>
                </div>
                <span class="minor-name">{p.title}</span> {commit.message}
              </li>
            ))}
          </ul>
          <p class="block-foot">
            <a href="https://github.com/Lavanic?tab=repositories" target="_blank" rel="noopener">
              see the rest
            </a>
          </p>
        </section>
      )}
      <section class="block">
        <h2 class="block-minor">Statistics</h2>
        <div class="pairs">
          <dl>
            <dt>Projects</dt>
            <dd>{projects.length}</dd>
          </dl>
          {known.length > 0 && (
            <>
              <dl>
                <dt>Commits</dt>
                <dd>{sum((repo) => repo.commits)}</dd>
              </dl>
              <dl>
                <dt>Stars</dt>
                <dd>{sum((repo) => repo.stars)}</dd>
              </dl>
            </>
          )}
          <dl>
            <dt>Latest project</dt>
            <dd>{projects[0].p.repo ? <a href={projects[0].p.repo}>{projects[0].p.title}</a> : projects[0].p.title}</dd>
          </dl>
        </div>
      </section>
    </aside>
  </div>
  <Viewer />
</Layout>

<style>
  .intro {
    margin: 0 0 10px;
    color: var(--dim);
  }

  /* the projects, and beside them a sidebar the width of the forum's */
  .columns {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .content {
    flex: 1;
    min-width: 0;
  }

  .sidebar {
    flex: none;
    width: 250px;
  }

  .block {
    scroll-margin-top: 10px;
  }

  .block-header {
    padding: 6px 10px;
    border-bottom: 1px solid var(--line);
    border-radius: 3px 3px 0 0;
    background: linear-gradient(0deg, #e8f4fc, #fff);
    color: var(--link);
    font-size: 1.25rem;
  }

  .block-header a {
    color: inherit;
  }

  .block-minor {
    padding: 6px 10px;
    color: var(--link);
    font-size: 1.0625rem;
  }

  ol,
  .log {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* plain text, in the manner of the changelog on ohrt.dev: date and hash, then what changed */
  .log {
    padding: 0 10px 4px;
    font-size: 0.8125rem;
  }

  .log li {
    padding-bottom: 6px;
  }

  .minor-name {
    color: var(--muted);
  }

  .block-foot {
    margin: 0;
    padding: 6px 10px;
    border-top: 1px solid var(--line);
    border-radius: 0 0 3px 3px;
    background: linear-gradient(180deg, #f5f5f5, #fafafa);
    color: var(--dim);
    font-size: 0.75rem;
  }

  .minor {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .pairs {
    padding: 6px 10px;
  }

  .pairs dl {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    margin: 0;
  }

  .pairs dt {
    color: var(--muted);
  }

  .pairs dt::after {
    content: ':';
  }

  .pairs dd {
    margin: 0;
    text-align: right;
  }

  ol > li + li {
    border-top: 1px solid var(--line);
  }

  .node {
    display: flex;
    align-items: center;
  }

  .node-icon {
    flex: none;
    width: 46px;
    padding-left: 10px;
    color: #c6e4f9;
  }

  .node-icon :global(svg) {
    display: block;
    width: 36px;
    height: 36px;
  }

  .node-main {
    flex: 1;
    min-width: 0;
    padding: 10px;
  }

  /* the gaps trail each piece, so one that wraps to a new line starts flush with the text */
  h3 {
    display: inline;
    margin-right: 6px;
    font-size: 1.0625rem;
  }

  .sub {
    margin-right: 6px;
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* the pale yellow of GitHub's archive notice */
  .label {
    display: inline-block;
    padding: 1px 0.45em;
    border: 1px solid rgb(212 167 44 / 0.6);
    border-radius: 4px;
    background: #fff8c5;
    color: rgb(31 35 40 / 0.75);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.26;
    white-space: nowrap;
    vertical-align: 1px;
  }

  .node-main p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--dim);
  }

  .links {
    margin-top: 0.3em;
    font-size: 0.8125rem;
  }

  .links > * + * {
    margin-left: 12px;
  }

  .stats-inline {
    display: none;
    color: var(--muted);
  }

  .node-stats {
    display: flex;
    flex: none;
    width: 140px;
    text-align: center;
  }

  .node-stats dl {
    flex: 1;
    margin: 0;
    padding: 0 3px;
  }

  .node-stats dt {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .node-stats dd {
    margin: 0;
  }

  .node-extra {
    flex: none;
    width: 280px;
    padding: 10px;
    font-size: 0.8125rem;
  }

  .media {
    display: flex;
    float: right;
    gap: 3px;
    margin-left: 10px;
  }

  /* one line, cut with an ellipsis, like the forum's last post */
  .commit {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* one line as well: when thumbnails leave no room for the hash it wraps out of sight whole, instead of being cut mid-way */
  .commit-meta {
    display: flex;
    flex-wrap: wrap;
    height: 1.4em;
    overflow: hidden;
    color: var(--muted);
    white-space: nowrap;
  }

  .sha::before {
    margin: 0 0.35em;
    content: '·';
  }

  .media a {
    cursor: zoom-in;
  }

  .media :global(img) {
    display: block;
    box-sizing: content-box;
    border: 1px solid var(--line);
    background: #fff;
  }

  .media a:hover :global(img) {
    border-color: var(--link);
  }

  /* no room for the two columns beside the sidebar: the numbers move into the line of links */
  @media (max-width: 1100px) {
    .node-stats {
      display: none;
    }

    .stats-inline {
      display: inline;
    }
  }

  /* the sidebar drops under the projects, its blocks side by side */
  @media (max-width: 1000px) {
    .columns {
      display: block;
    }

    .sidebar {
      display: flex;
      flex-wrap: wrap;
      gap: 0 10px;
      width: auto;
    }

    .sidebar > * {
      flex: 1 1 250px;
    }
  }

  @media (max-width: 650px) {
    .block-header {
      border-radius: 0;
    }

    .sidebar {
      display: block;
    }

    .node {
      flex-wrap: wrap;
    }

    /* under the text, not under the icon */
    .node-extra {
      flex-basis: 100%;
      margin-top: -4px;
      padding: 0 10px 10px 56px;
    }

    .media {
      float: none;
      margin: 0 0 6px;
    }
  }
</style>
